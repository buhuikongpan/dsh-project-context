{
  "name": "dsh-project-context",
  "version": "0.9.0",
  "description": "给 DSH 一个「临时会话」：侧边栏底部的按钮把新会话开进固定的临时工作区（$DSH_HOME/workspace/default，首次运行自动创建），于是这些会话就显示在侧边栏那个「临时会话」文件夹下面；项目工作区照旧注入精简的项目约定，临时会话不注入任何提示词，插件也不改你的权限配置。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/state.js && node -e \"new Function(require('fs').readFileSync('lib/client.js','utf8'))\"",
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "workspace-purpose",
    "conversation-workspace",
    "project-context"
  ],
  "license": "MIT"
}
